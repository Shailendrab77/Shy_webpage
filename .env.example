# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Admin
ADMIN_API_KEY=change-me-to-a-strong-secret

# Business rules
MAX_PAYOUT_AMOUNT=100000
REQUEST_CODE_PREFIX=PAY
REQUEST_CODE_START=10001
ALLOW_PAYOUT_CANCELLATION=true
DUPLICATE_REQUEST_WINDOW_MINUTES=30
MIN_PAYOUT_AMOUNT=1
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Google Sheets
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Use \n for newlines when embedding the private key in .env
GOOGLE_PRIVATE_KEY=
# Optional: path to a service-account JSON file (alternative to email+key)
# GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json
GOOGLE_SHEETS_CUSTOMERS_RANGE=Customers!A:G
GOOGLE_SHEETS_PAYOUTS_RANGE=PayoutRequests!A:J

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_API_BASE_URL=https://graph.facebook.com

# LLM Provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_PROVIDER=openai
# Set to "heuristic" to run without an LLM (rule-based parsing only)
# LLM_PROVIDER=heuristic

# Conversation / idempotency (in-memory by default; swap later for Redis)
CONVERSATION_TTL_MINUTES=60
IDEMPOTENCY_TTL_HOURS=24
